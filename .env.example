# Copiare in .env.local. Le variabili NEXT_PUBLIC_* sono visibili al browser: mai la service role.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
# 32 byte casuali codificati base64: `openssl rand -base64 32`. Cifra le note L3. Solo lato server.
SOSTENIAMO_FIELD_ENCRYPTION_KEY=replace_me
# Solo per gli script di seed/amministrazione, mai nel runtime web:
# SUPABASE_SERVICE_ROLE_KEY=
